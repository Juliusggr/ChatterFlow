{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability for employee, shift, and model reads.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-sync-all-models",
    "allow-get-analytics",
    "allow-export-analytics",
    "allow-get-earnings-overview",
    "allow-get-my-shifts",
    "allow-get-clocked-in-employees",
    "allow-get-employee-sales",
    "allow-get-employees",
    "allow-add-employee",
    "allow-update-employee-role-schedule",
    "allow-delete-employee",
    "allow-toggle-clock-in",
    "allow-get-models",
    "allow-open-model-session",
    "allow-open-messages",
    "allow-get-message-tabs",
    "allow-set-message-bar-placement",
    "allow-set-insights-open",
    "allow-select-message-tab",
    "allow-close-message-tab",
    "allow-get-recent-notifications",
    "allow-clear-notifications",
    "allow-dismiss-notification",
    "allow-open-incoming-chat",
    "allow-set-notification-delivery",
    "notification:default",
    "allow-save-fan-notes",
    "allow-fan-selected",
    "allow-list-inbox",
    "allow-list-thread",
    "allow-send-message",
    "allow-delete-model",
    "allow-sync-model-data",
    "allow-list-vault-media",
    "allow-download-vault-media"
  ]
}
