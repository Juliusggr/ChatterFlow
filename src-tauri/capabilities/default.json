{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability for Supabase-backed sessions, notifications, and vault tools.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-set-supabase-session",
    "allow-get-models",
    "allow-refresh-models",
    "allow-set-app-theme",
    "allow-open-model-session",
    "allow-open-messages",
    "allow-get-message-tabs",
    "allow-set-message-bar-placement",
    "allow-set-insights-open",
    "allow-select-message-tab",
    "allow-close-message-tab",
    "allow-get-recent-notifications",
    "allow-clear-notifications",
    "allow-dismiss-notification",
    "allow-open-incoming-chat",
    "allow-set-notification-delivery",
    "notification:default",
    "allow-fan-selected",
    "allow-delete-model",
    "allow-sync-model-data",
    "allow-list-vault-media",
    "allow-download-vault-media"
  ]
}
