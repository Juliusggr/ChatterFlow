{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "messages-tabs",
  "description": "Top model tab bar for the shared messages window.",
  "webviews": ["messages-tabs"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-set-supabase-session",
    "allow-get-models",
    "allow-get-message-tabs",
    "allow-set-message-bar-placement",
    "allow-set-insights-open",
    "allow-open-messages",
    "allow-select-message-tab",
    "allow-close-message-tab"
  ]
}
